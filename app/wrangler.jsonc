{
  // miyamaker.com: static build (dist/) + the API proxies in api/worker.ts. Deploy with `yarn deploy`.
  // VITE_ vars are read at build time from .env.production.local (gitignored); see .env.example.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miyamaker",
  "main": "api/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Hashed assets skip the Worker (they don't count against its request quota); page loads and /api/* need it.
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/icons/*", "!/sounds/*"]
  },
  // Secrets (not in this file): npx wrangler secret put ZEROX_API_KEY
  //                             npx wrangler secret put OPENSEA_API_KEY
  //                             npx wrangler secret put YOUTUBE_API_KEY
  //                             npx wrangler secret put ETHERSCAN_API_KEY
  //   Keyed RPC (api/_lib/rpc.ts), each optional (unset = public RPCs):
  //                             npx wrangler secret put RPC_URL_1
  //                             npx wrangler secret put RPC_URL_4663
  //                             npx wrangler secret put RPC_URL_11155111
  //                             npx wrangler secret put ALCHEMY_API_KEY
  //   VITE_RPC_URL_* and VITE_ALCHEMY_KEY are no longer read: remove them from .env.production.local.
  //   Optional, miyakeys's per-visitor tag for nuroctane.xyz (api/_lib/miyakeys.ts clientTag; 32+ random characters):
  //                             npx wrangler secret put MIYAKEYS_CLIENT_SECRET
  // The API's rate limits in the Worker are per isolate; the global one is a Cloudflare WAF rate-limiting rule on /api/*
  // (dashboard, not this file): see createRateLimiter in api/_lib/zeroex.ts for the recommended rule.
  // Wallets that can remove any track from the radio's community station, comma-separated. miyagod.eth.
  "vars": { "STATION_ADMINS": "0x5167D014a056E43883e1BBEa5530c3c0dC993281" },
  // The radio's community station (api/_lib/station.ts), public access, used signatures, miyatv's shared lookups
  // (api/_lib/sharedstate.ts) and the reveal's mints and draws (api/_lib/reveal.ts). Schema: migrations/, npx wrangler d1 migrations apply miyamaker-station --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miyamaker-station",
      "database_id": "ce765b7f-e5cb-4b66-bfbc-68ad7bbdce64",
      "migrations_dir": "migrations"
    }
  ],
  // The per-mint reveal's private art (api/_lib/reveal.ts). The bucket must exist before a deploy with this binding;
  // keep it private: no r2.dev URL, no custom domain (the Worker serves drawn pieces only).
  // Admin key for scripts/reveal/*: npx wrangler secret put REVEAL_ADMIN_KEY   (32+ random characters)
  // REVEAL_DEV, REVEAL_RPC_URL and an http REVEAL_ORIGIN are for local rehearsals (wrangler dev) only: never set them
  // here or as secrets. Without REVEAL_DEV=1 the reveal reads only RPC_URL_1 and attaches only https://www.miyamaker.com.
  "r2_buckets": [{ "binding": "REVEAL", "bucket_name": "miyamaker-reveal" }],
  // The reveal's cron: reads new mints and draws their pieces (runRevealCron). Needs RPC_URL_1 (archive, e.g. Alchemy).
  // Every 15 minutes (owner, 2026-11-12): a minter sees the cover for up to ~16 minutes before their piece.
  "triggers": { "crons": ["*/15 * * * *"] },
  "workers_dev": false,
  "routes": [
    { "pattern": "www.miyamaker.com", "custom_domain": true },
    { "pattern": "miyamaker.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
