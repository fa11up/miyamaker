# WalletConnect Cloud project id (https://cloud.walletconnect.com). Optional:
# without it, WalletConnect-based wallets are hidden and injected wallets still work.
VITE_WC_PROJECT_ID=

# Optional per-chain RPC overrides (otherwise public RPCs are used)
VITE_RPC_URL_1=
VITE_RPC_URL_11155111=
VITE_RPC_URL_4663=

# Optional GraphQL indexer. When unset, indexer-backed sections are hidden.
VITE_GRAPHQL_URL=

VITE_ANALYTICS_ID=

# Path-style IPFS gateway for ipfs:// metadata (default: https://ipfs.filebase.io/ipfs/)
VITE_IPFS_GATEWAY=

# Optional Alchemy key for the desktop "My Files" window (NFT API v3 getNFTsForOwner, mainnet).
# With it, every NFT in the connected wallet is listed; without it, only known collections
# (MIYAMINI, Miya Auction, Milady; see src/desktop/collections.ts) are read straight from the chain.
# VITE_ vars are bundled into the client: use a key restricted to your domains with only the NFT API.
VITE_ALCHEMY_KEY=

# Music drops (Drop Music window, Mint → Music, miya radio). ERC1155Factory and a MiyaRegistry-registered
# alignment vault per chain (1 = Ethereum, 11155111 = Sepolia, 4663 = Robinhood Chain). Without a factory the
# window can still upload files and build metadata, and the listing shows only pasted/locally launched collections.
VITE_MUSIC_FACTORY_1=
VITE_MUSIC_VAULT_1=
VITE_MUSIC_FACTORY_11155111=
VITE_MUSIC_VAULT_11155111=
VITE_MUSIC_FACTORY_4663=
VITE_MUSIC_VAULT_4663=

# Other miyamints contracts (contracts/script/DeployMiyamints.s.sol prints every line). All optional: when unset,
# src/constants/contracts.ts falls back to contracts/deployments/<chainId>.json from a broadcast deploy.
# Suffix = chain id (1, 11155111, 4663).
VITE_MIYA_REGISTRY_1=
VITE_ERC721_DROP_FACTORY_1=
VITE_ERC721_AUCTION_FACTORY_1=
VITE_MIYA_POOL_FACTORY_1=
# Trade → NFTs lists the MiyaPool pools of this factory. Unset on a chain = "not on this network yet".
VITE_MIYA_POOL_FACTORY_11155111=
VITE_MIYA_POOL_FACTORY_4663=
VITE_VAULT_FACTORY_1=

# --- Trade window, Tokens tab (server-side only; NOT VITE_-prefixed, never bundled) ---
# 0x API key from https://dashboard.0x.org. Read by the Vite dev middleware (shell env or
# app/.env.local) and by the Vercel functions in app/api/0x. Without it the Tokens tab shows
# "Swap service not configured". The swap fee is hardcoded in api/_lib/zeroex.ts, not configurable.
ZEROX_API_KEY=

# --- Trade window, NFTs tab: other markets (server-side only; NOT VITE_-prefixed, never bundled) ---
# OpenSea API v2 key, free: https://docs.opensea.io/reference/api-keys (opensea.io → Settings → Developer, or the
# instant 7-day key: curl -X POST https://api.opensea.io/api/v2/auth/keys). Read by the Vite dev middleware and the
# Vercel function app/api/opensea.ts. With it: listings, offers, name search, wallet NFTs and in-app buy / accept
# offer. Without it: floor prices may still show (OpenSea serves a few reads keyless), every venue link works, and
# the page says "prices need an API key". Blur and Magic Eden have no public price API: links only.
OPENSEA_API_KEY=

# --- miyatv chat ---
# Base URL of the miyatv chat worker (chat/ in this monorepo: Cloudflare Worker + Durable Objects),
# e.g. https://chat.miyamaker.com, or http://127.0.0.1:8787 while running `npx wrangler dev` in chat/.
# Unset = the miyatv chat tab shows "chat offline"; the channels and platform chats still work.
VITE_CHAT_URL=
