{
  // miyatv chat: Worker router + one Durable Object per chat room. See README.md for deploy steps.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miyatv-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  "vars": {
    // Production only. Local dev adds the localhost origins in .dev.vars (see .dev.vars.example).
    "ALLOWED_ORIGINS": "https://miyamaker.com,https://www.miyamaker.com",
    "MOD_ADDRESSES": "0x5167D014a056E43883e1BBEa5530c3c0dC993281"
  },
  // Secrets (not in this file): SESSION_SECRET  ->  npx wrangler secret put SESSION_SECRET
  //                            RPC_URL (optional, keyed mainnet RPC; public node otherwise) -> npx wrangler secret put RPC_URL
  // miyagod.eth moderates.
  "routes": [{ "pattern": "chat.miyamaker.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
