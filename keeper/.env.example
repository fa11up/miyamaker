# Copy to .env (mode 600). NEVER commit .env.
# The keeper's HOT key: it only needs gas. Prefer a file outside the repo:
# KEEPER_KEY_FILE=/home/keeper/.keys/vault-keeper.hex
# KEEPER_PRIVATE_KEY=
# Where signed transactions go (comma-separated, tried in order). Without it the keeper never sends.
# PRIVATE_RPC_URL=https://rpc.flashbots.net/fast
# VAULTS=0x...,0x...
# READ_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
# KEEPER_STOP=1   # kill switch (or: touch state/STOP)
