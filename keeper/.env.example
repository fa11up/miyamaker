# Copy to ~/imd-vault-keeper/.env (mode 600). NEVER commit .env.
# The keeper's HOT key: it only needs gas. A file outside the app dir, bound read-only by keeper.service:
# KEEPER_KEY_FILE=/home/keeper/.config/imd-vault-keeper/keeper.key
# KEEPER_PRIVATE_KEY=
# 0x Swap API v2 key (sent only as the 0x-api-key header). Without it every swap uses the zRouter fallback.
# ZEROEX_API_KEY=
# Where signed transactions go (comma-separated, tried in order). Default: MEV Blocker, reverting txs never included.
# Other MEV Blocker endpoints: https://rpc.mevblocker.io/fast, https://rpc.mevblocker.io/fullprivacy
# PRIVATE_RPC_URL=https://rpc.mevblocker.io/noreverts
# VAULTS=0x...,0x...
# READ_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
# USE_IMD_FEED=false   # true: also check the ETH leg against the IMD price feed
# KEEPER_STOP=1   # kill switch (or: touch state/STOP)
